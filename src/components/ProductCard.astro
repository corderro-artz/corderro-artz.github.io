---
/**
 * ProductCard — Reusable product/project card for the Vaporsoft architecture page.
 *
 * @prop {string}  name        – Display name of the product.
 * @prop {string}  description – One-line product description.
 * @prop {string}  [icon]      – Icon base name (e.g. "akira" → /brand/akira/akira-icon.svg & /brand/akira/akira-icon-light.svg).
 *                               Brand assets live under /brand/ because this is a user Pages site: a repository with its
 *                               own Pages site is served at /<repo>/ and shadows any top-level directory of the same name.
 * @prop {string}  [iconSrc]   – An explicit mark, for a card whose icon is not a product icon under
 *                               the /brand/<name>/<name>-icon.svg convention (the brand card uses the logo).
 * @prop {string}  [iconSrcLight] – Its light-theme twin.
 * @prop {string}  [href]      – Where the card leads. When set, renders as <a>. A site-relative
 *                               path stays in the tab; an absolute URL opens a new one.
 * @prop {string}  label       – Category label (FABRIC, SURFACE, etc.).
 * @prop {'foundation'|'surface'|'standalone'|'future'} [variant='surface'] – Card presentation variant.
 */
interface Props {
  name: string;
  description: string;
  icon?: string;
  iconSrc?: string;
  iconSrcLight?: string;
  href?: string;
  label: string;
  variant?: 'foundation' | 'surface' | 'standalone' | 'future';
}

const { name, description, icon, iconSrc, iconSrcLight, href, label, variant = 'surface' } = Astro.props;

// An explicit pair wins over the naming convention, and either is drawn the
// same way: one image per theme, swapped by the class the toggle sets.
const markDark = iconSrc || (icon ? `/brand/${icon}/${icon}-icon.svg` : null);
const markLight = iconSrcLight || (icon ? `/brand/${icon}/${icon}-icon-light.svg` : null);

// The product pages live on this site now, so most cards no longer leave it.
// Sending an in-site navigation to a new tab is the behaviour the repository
// pages exist to stop.
const isExternal = Boolean(href && /^https?:/i.test(href));
const linkLabel = isExternal ? `Open ${name} on GitHub` : `Open the ${name} page`;

const isFoundation = variant === 'foundation';
const isStandalone = variant === 'standalone';
const isFuture = variant === 'future';

const classes = [
  'vapor-arch-card',
  isFoundation || isStandalone ? 'vapor-frame' : 'vapor-panel',
  isStandalone ? 'vapor-arch-card--standalone' : '',
  isFoundation ? 'vapor-arch-card--foundation' : '',
  !isFuture ? 'vapor-arch-card--active' : 'vapor-arch-card--future',
].filter(Boolean).join(' ');
---

{href ? (
  <a
    class={classes}
    href={href}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    aria-label={linkLabel}
  >
    <div class="vapor-arch-card-icon">
      {markDark ? (
        <>
          <img src={markDark} alt={name} width="72" height="72" class="vapor-arch-icon vapor-arch-icon--dark" />
          <img src={markLight} alt={name} width="72" height="72" class="vapor-arch-icon vapor-arch-icon--light" />
        </>
      ) : (
        <span class="vapor-arch-placeholder-icon"></span>
      )}
    </div>
    <h3>{name}</h3>
    <p class="vapor-arch-desc">{description}</p>
    <span class="vapor-meta">{label}</span>
  </a>
) : (
  <article class={classes}>
    <div class="vapor-arch-card-icon">
      {markDark ? (
        <>
          <img src={markDark} alt={name} width="72" height="72" class="vapor-arch-icon vapor-arch-icon--dark" />
          <img src={markLight} alt={name} width="72" height="72" class="vapor-arch-icon vapor-arch-icon--light" />
        </>
      ) : (
        <span class="vapor-arch-placeholder-icon"></span>
      )}
    </div>
    <h3>{name}</h3>
    <p class="vapor-arch-desc">{description}</p>
    <span class="vapor-meta">{label}</span>
  </article>
)}
