---
/**
 * The repository console, rendered by every route that shows one.
 *
 * Two routes use it: /<repo>/ opens on Overview, /<repo>/docs/ opens on
 * Documentation. They are the same page — the panels are all in the markup
 * either way — but each has its own address, so a link to the documentation
 * is a link to the documentation rather than to a page the reader then has to
 * click. Each URL carries its own canonical, title and description.
 *
 * Everything on it is rendered here, at build time, from the payload
 * scripts/fetch-repo-data.mjs fetched at the start of this build — including the open panel and the
 * contents index, so the page is complete before any script runs and stays
 * complete if none ever does. The browser only switches panels, scrolls the
 * document pane to a heading, and marks where in the document the reader is.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from './SiteFooter.astro';
import repos from '../data/repos.json';
import sync from '../data/sync.json';
import { renderRepoPage, repoStructuredData, displayName } from '../lib/repo-page.mjs';
import '../styles/repo.css';

const { slug, tab = 'overview' } = Astro.props;
const repo = repos[slug];
const onDocs = tab === 'documentation';
const name = displayName(slug);
const siteUrl = Astro.site ?? new URL('https://www.vaporsoft.dev');

const summary = repo.description || `${name}, an open-source project by Vaporsoft.`;
const description = onDocs
  ? `Documentation for ${name}. ${summary}`
  : summary;

const structuredData = [
  repoStructuredData(repo, siteUrl),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Vaporsoft', item: new URL('/', siteUrl).href },
      { '@type': 'ListItem', position: 2, name, item: new URL(`/${slug}/`, siteUrl).href },
      ...(onDocs
        ? [{ '@type': 'ListItem', position: 3, name: 'Documentation',
             item: new URL(`/${slug}/docs/`, siteUrl).href }]
        : [])
    ]
  }
];

const keywords = [
  name,
  `${name} docs`,
  `${name} documentation`,
  `${name} releases`,
  'Vaporsoft',
  'open source',
  ...Object.keys(repo.languages)
];
---

<BaseLayout
  title={onDocs ? `${name} documentation | Vaporsoft` : `${name} | Vaporsoft`}
  description={description}
  bodyClass="vapor-repo-body"
  keywords={keywords}
  ogType="article"
  ogImage={`/brand/${slug}/png/${slug}-icon.png`}
  ogImageWidth={512}
  ogImageHeight={512}
  structuredData={structuredData}
>
  <main class="rp-shell" set:html={renderRepoPage(repo, tab, sync.syncedAt)} />
  <SiteFooter class="rp-foot" />

  <script is:inline>
    (function () {
      var stage = document.querySelector('.rp-shell');
      if (!stage) return;

      /* A tab rail: WAI-ARIA roving tabindex, so the arrow keys walk the rail
         and only the selected tab is in the tab order. */
      function wireRail(root, sel, attr, apply) {
        var tabs = Array.prototype.slice.call(root.querySelectorAll(sel));
        if (!tabs.length) return tabs;
        function select(t) {
          tabs.forEach(function (x) {
            var on = x === t;
            x.setAttribute('aria-selected', String(on));
            x.setAttribute('tabindex', on ? '0' : '-1');
          });
          apply(t.getAttribute(attr));
        }
        tabs.forEach(function (t) {
          t.addEventListener('click', function () { select(t); });
          t.addEventListener('keydown', function (e) {
            var i = tabs.indexOf(t);
            var next = null;
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = tabs[(i + 1) % tabs.length];
            else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = tabs[(i - 1 + tabs.length) % tabs.length];
            else if (e.key === 'Home') next = tabs[0];
            else if (e.key === 'End') next = tabs[tabs.length - 1];
            if (!next) return;
            e.preventDefault();
            select(next);
            next.focus();
          });
        });
        return tabs;
      }

      var panels = Array.prototype.slice.call(stage.querySelectorAll('.rp-panel'));

      /* The repository's own root, whichever route we were served from, so
         switching tabs can rewrite the address to match what is on screen.
         replaceState rather than pushState: the back button should leave the
         page, not walk back through tabs the reader clicked past. */
      var root = location.pathname.replace(/docs\/?$/, '');
      if (root.charAt(root.length - 1) !== '/') root += '/';

      var mainTabs = wireRail(stage, '.rp-tab', 'data-tab', function (id) {
        panels.forEach(function (p) { p.classList.toggle('is-on', p.dataset.panel === id); });
        var btn = stage.querySelector('.rp-tab[data-tab="' + id + '"]');
        var next = root + (btn ? btn.dataset.url || '' : '');
        if (next !== location.pathname && history.replaceState) {
          try { history.replaceState(null, '', next + location.hash); } catch (e) {}
        }
      });
      // Each panel's own rail, for the widths where its columns become pages.
      var subRails = {};
      panels.forEach(function (p) {
        subRails[p.dataset.panel] = wireRail(p, '.rp-subtab', 'data-block', function (id) {
          p.querySelectorAll('.rp-block').forEach(function (b) {
            b.classList.toggle('is-on', b.dataset.block === id);
          });
        });
      });

      // A button inside one panel that leads to another — Latest release, Read
      // the documentation — is a press of that panel's tab, so the rail, the
      // address and the open panel all agree afterwards.
      stage.querySelectorAll('[data-goto]').forEach(function (b) {
        b.addEventListener('click', function () {
          var t = mainTabs.filter(function (x) { return x.dataset.tab === b.dataset.goto; })[0];
          if (t) { t.click(); t.focus(); }
        });
      });

      /* Releases: an index and the page it selects. Every entry is a link to
         the release on GitHub; the ones whose notes are in the page open here
         instead. Where the two columns have become sub-tabs, picking a version
         turns to its notes. */
      var relPanel = stage.querySelector('.rp-panel[data-panel="releases"]');
      if (relPanel) {
        var vers = Array.prototype.slice.call(relPanel.querySelectorAll('.rp-ver[data-rel]'));
        var notes = Array.prototype.slice.call(relPanel.querySelectorAll('.rp-rel-item'));
        var notesBody = relPanel.querySelector('.rp-notes-body');
        vers.forEach(function (v) {
          v.addEventListener('click', function (e) {
            e.preventDefault();
            vers.forEach(function (x) {
              var on = x === v;
              x.classList.toggle('is-on', on);
              if (on) x.setAttribute('aria-current', 'true'); else x.removeAttribute('aria-current');
            });
            notes.forEach(function (n) { n.hidden = n.dataset.rel !== v.dataset.rel; });
            if (notesBody) notesBody.scrollTop = 0;
            var sub = (subRails.releases || []).filter(function (x) { return x.dataset.block === 'notes'; })[0];
            if (sub && sub.offsetParent !== null) sub.click();
          });
        });
      }

      /* How old the record is. The server wrote the absolute time; this says
         it the way a person would, and then asks GitHub whether anything has
         been pushed since. One unauthenticated request per repository, kept for
         ten minutes, so browsing the four pages costs four of the sixty an
         hour the API allows. If it cannot answer, the line just keeps the
         time — which is still true. */
      var sync = document.querySelector('[data-sync]');
      if (sync) {
        var syncLabel = sync.querySelector('[data-sync-label]');
        var syncedAt = Date.parse(sync.dataset.synced);
        var state = { upstream: null };
        var ago = function (ms) {
          var m = Math.round(ms / 60000);
          if (m < 1) return 'just now';
          if (m < 60) return m + ' min ago';
          var h = Math.round(m / 60);
          if (h < 24) return h + (h === 1 ? ' hour ago' : ' hours ago');
          var d = Math.round(h / 24);
          return d + (d === 1 ? ' day ago' : ' days ago');
        };
        var paint = function () {
          var now = Date.now();
          if (state.upstream) {
            sync.dataset.state = 'behind';
            syncLabel.textContent = 'Updating · changed on GitHub ' + ago(now - state.upstream);
            sync.title = 'GitHub has changes from ' + new Date(state.upstream).toLocaleString()
              + ' that this page does not show yet. The site rebuilds itself within a few minutes.';
          } else {
            syncLabel.textContent = 'Synced ' + ago(now - syncedAt);
          }
        };
        paint();
        setInterval(paint, 60000);

        var repo = sync.dataset.repo;
        var pushed = Date.parse(sync.dataset.pushed);
        var settle = function (ghPushed) {
          if (!ghPushed) return;
          if (ghPushed > pushed) {
            state.upstream = ghPushed;
          } else {
            sync.dataset.state = 'current';
            sync.title = 'Matches GitHub as of ' + new Date().toLocaleTimeString()
              + '. Fetched ' + new Date(syncedAt).toLocaleString() + '.';
          }
          paint();
        };
        if (repo && pushed && window.fetch) {
          var key = 'vapor-gh:' + repo;
          var cached = null;
          try { cached = JSON.parse(sessionStorage.getItem(key) || 'null'); } catch (e) {}
          if (cached && Date.now() - cached.at < 600000) {
            settle(cached.pushed);
          } else {
            fetch('https://api.github.com/repos/' + repo, { headers: { Accept: 'application/vnd.github+json' } })
              .then(function (r) { return r.ok ? r.json() : null; })
              .then(function (j) {
                if (!j || !j.pushed_at) return;
                var p = Date.parse(j.pushed_at);
                try { sessionStorage.setItem(key, JSON.stringify({ pushed: p, at: Date.now() })); } catch (e) {}
                settle(p);
              })
              .catch(function () {});
          }
        }
      }

      stage.querySelectorAll('[data-copy]').forEach(function (b) {
        b.addEventListener('click', function () {
          var src = document.getElementById(b.dataset.copy);
          if (!src || !navigator.clipboard) return;
          navigator.clipboard.writeText(src.textContent).then(function () {
            b.textContent = 'Copied';
            setTimeout(function () { b.textContent = 'Copy'; }, 1400);
          }, function () {});
        });
      });

      /* The index itself is rendered at build time; what is left for the
         browser is making it move the right box, and saying where the reader
         currently is. */
      var nav = stage.querySelector('.rp-toc');
      var body = stage.querySelector('.rp-doc-body');
      var readme = body && body.querySelector('.rp-readme');
      if (!nav || !readme) return;

      var links = Array.prototype.slice.call(nav.querySelectorAll('a'));
      var heads = links
        .map(function (a) { return readme.querySelector('[id="' + a.dataset.to + '"]'); })
        .filter(Boolean);
      if (!heads.length) return;

      links.forEach(function (a) {
        a.addEventListener('click', function (e) {
          var h = readme.querySelector('[id="' + a.dataset.to + '"]');
          if (!h) return;
          e.preventDefault();
          // The page itself does not scroll, so scrollIntoView would move the
          // wrong box. The document's own pane is the scroller; move it by the
          // difference between the heading's top and the pane's, which holds
          // whatever the pane's current offset is.
          body.scrollTop += h.getBoundingClientRect().top - body.getBoundingClientRect().top - 8;
        });
      });

      // Which heading the reader is under, so the index says where they are
      // and not only where they can go.
      var queued = false;
      function mark() {
        queued = false;
        var top = body.getBoundingClientRect().top + 14;
        var current = heads[0];
        heads.forEach(function (h) { if (h.getBoundingClientRect().top <= top) current = h; });
        links.forEach(function (a) { a.classList.toggle('is-here', a.dataset.to === current.id); });
      }
      body.addEventListener('scroll', function () {
        if (queued) return;
        queued = true;
        requestAnimationFrame(mark);
      }, { passive: true });
      mark();
    })();
  </script>
</BaseLayout>
