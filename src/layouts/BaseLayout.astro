---
import '../styles/global.css';

const defaultDescription = 'Vaporsoft builds clean digital systems with precision, atmosphere, and technical clarity.';

const {
  title = 'Vaporsoft',
  description = defaultDescription,
  themeColor = '#07080b',
  bodyClass = '',
  keywords = [],
  ogType = 'website',
  // Must be a raster format. Google, X, LinkedIn, Slack and Discord all refuse
  // SVG for link previews, so an SVG here means every share renders with no
  // image at all. Keep the declared dimensions in step with the file.
  ogImage = '/brand/vaporsoft/png/vaporsoft-social-card-1200x630.png',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageType = 'image/png',
  // A wide image gets the large card; a square icon stays a thumbnail.
  twitterCard = ogImageWidth / ogImageHeight > 1.5 ? 'summary_large_image' : 'summary',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  structuredData = []
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://www.vaporsoft.dev');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL(ogImage, siteUrl);
// The Organization node shares one @id on every page, so it must say the same
// thing on every page: the Vaporsoft logo and description, never the page's
// own share image or summary (a product icon, or a 2400×1260 banner).
const orgLogoUrl = new URL('/brand/vaporsoft/png/vaporsoft-logo.png', siteUrl);
// Every kanji the site sets: the landing, contact and 404 rules, and the
// console section glyphs in src/lib/repo-page.mjs and src/lib/brand-page.mjs.
const kanji = '仮想織問無仕様構成開発目次文書版履歴壁紙帯札印符章色階索寄品';
const keywordContent = Array.isArray(keywords) ? keywords.join(', ') : keywords;
const defaultStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#organization', siteUrl).href,
    name: 'Vaporsoft',
    // Google spell-corrects a one-word brand toward a more established two-word
    // term unless it can resolve the brand as an entity. These spellings, the
    // founder link and sameAs are what give it something to resolve against.
    alternateName: ['VaporSoft', 'Vapor Soft', 'vaporsoft.dev'],
    url: siteUrl.href,
    logo: {
      '@type': 'ImageObject',
      url: orgLogoUrl.href,
      width: 512,
      height: 512
    },
    image: orgLogoUrl.href,
    description: defaultDescription,
    slogan: 'A single loom to spin many threads',
    founder: {
      '@type': 'Person',
      name: 'Corderro Artz',
      url: 'https://github.com/corderro-artz'
    },
    knowsAbout: [
      'Software development',
      'Developer tools',
      'Cross-platform system telemetry',
      'Model Context Protocol',
      'Local-first software',
      'Design tooling'
    ],
    sameAs: ['https://github.com/corderro-artz'],
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'business inquiries',
        url: new URL('/contact/', siteUrl).href,
        availableLanguage: ['English']
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', siteUrl).href,
    name: 'Vaporsoft',
    alternateName: 'Vaporsoft — Developer and Design Tools',
    url: siteUrl.href,
    description,
    inLanguage: 'en-US',
    publisher: { '@id': new URL('/#organization', siteUrl).href }
  }
];
const structuredDataNodes = [
  ...defaultStructuredData,
  ...(Array.isArray(structuredData) ? structuredData : [structuredData])
].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {keywordContent && <meta name="keywords" content={keywordContent} />}
    {/*
      Mobile browsers paint their chrome, and the strip revealed by overscroll,
      with theme-color. The site's theme comes from a manual toggle stored in
      localStorage and ignores the OS, so keying theme-color to
      prefers-color-scheme paints a near-white band under a black page on a
      light phone, and a black band under a paper page on a dark one. One tag,
      rewritten from the resolved theme before first paint and on every toggle.
      color-scheme is set from the same class in CSS for the same reason.
    */}
    <meta name="theme-color" content={themeColor} />
    <meta name="author" content="Vaporsoft" />
    <meta name="generator" content={Astro.generator} />
    <meta name="application-name" content="Vaporsoft" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang="en" href={canonicalUrl.href} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl.href} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content="Vaporsoft" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content="Vaporsoft brand mark" />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalUrl.href} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="twitter:image:alt" content="Vaporsoft brand mark" />
    <link rel="icon" type="image/svg+xml" href="/brand/vaporsoft/vaporsoft-favicon.svg" data-favicon data-dark-href="/brand/vaporsoft/vaporsoft-favicon.svg" data-light-href="/brand/vaporsoft/vaporsoft-favicon-light.svg" />
    {/* iOS ignores an SVG here and saves a screenshot instead. A 180px PNG
        downscaled from the rendered logo, corners filled with ink, since iOS
        paints transparency black anyway. */}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/*
      Two requests. The Latin faces carry only the weights the CSS resolves to
      (measured over every route: Space Grotesk and Zen Kaku never render at
      700). Zen Kaku is only ever used for a handful of kanji, and asking for
      the whole face shipped ~350 KB of @font-face rules for its CJK subsets
      alone, render-blocking on every page; `text=` gets one tiny subset.
      A kanji added to the site must be added to `kanji` below, or it falls
      back to a system face.
    */}
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@400;500&family=Syncopate:wght@400;700&display=swap" rel="stylesheet" />
    <link href={`https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500&display=swap&text=${encodeURIComponent(kanji)}`} rel="stylesheet" />
    {structuredDataNodes.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
    <slot name="head" />
    <title>{title}</title>
    <script is:inline>
      (function(){
        function setFavicon(isLight){
          var icons=document.querySelectorAll('link[data-favicon]');
          icons.forEach(function(link){
            var href=isLight?link.getAttribute('data-light-href'):link.getAttribute('data-dark-href');
            if(href)link.setAttribute('href',href);
          });
        }
        function setThemeColor(isLight){
          var meta=document.querySelector('meta[name="theme-color"]');
          if(meta)meta.setAttribute('content',isLight?'#f2ede6':'#07080b');
        }
        // Storage throws, rather than returning null, where site data is
        // blocked. Fall through to the light default instead of dying here.
        var t=null;
        try{t=localStorage.getItem('vapor-theme');}catch(e){}
        document.documentElement.classList.toggle('vapor-light',t!=='dark');
        var light=document.documentElement.classList.contains('vapor-light');
        setFavicon(light);
        setThemeColor(light);
        window.__vaporSetFavicon=setFavicon;
        window.__vaporSetThemeColor=setThemeColor;
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
    <script is:inline>
      (function(){
        // Sync body theme class with html (head script applies to html before body exists)
        var light=document.documentElement.classList.contains('vapor-light');
        document.body.classList.toggle('vapor-light',light);
        if(window.__vaporSetFavicon)window.__vaporSetFavicon(light);
        if(window.__vaporSetThemeColor)window.__vaporSetThemeColor(light);

        // Theme toggle
        var toggle=document.querySelector('[data-theme-toggle]');
        if(toggle){
          var label=toggle.querySelector('[data-theme-label]');
          function sync(){
            var light=document.documentElement.classList.contains('vapor-light');
            if(label)label.textContent=light?'LIGHT':'DARK';
            // The name starts with the word on the button, so a speech user
            // saying "click Light" reaches it, and it says what a press does.
            toggle.setAttribute('aria-label',light?'Light theme, switch to dark':'Dark theme, switch to light');
            document.body.classList.toggle('vapor-light',light);
            if(window.__vaporSetFavicon)window.__vaporSetFavicon(light);
            if(window.__vaporSetThemeColor)window.__vaporSetThemeColor(light);
          }
          sync();
          toggle.addEventListener('click',function(){
            document.documentElement.classList.toggle('vapor-light');
            // The choice just won't persist if storage is blocked; html and
            // body must still end up agreeing.
            try{localStorage.setItem('vapor-theme',document.documentElement.classList.contains('vapor-light')?'light':'dark');}catch(e){}
            sync();
          });
        }

        // Landing / arch glow animation (GPU-composited: opacity + transform only)
        var snap=document.querySelector('.vapor-snap-container');
        var noiseLand=document.querySelector('.vapor-noise--landing');
        var noiseArch=document.querySelector('.vapor-noise--arch');
        var scrollCue=document.querySelector('.vapor-scroll-cue');
        if(snap&&noiseLand){
          var ticking=false;
          function onScroll(){
            if(!ticking){ticking=true;requestAnimationFrame(updateGlow);}
          }
          function updateGlow(){
            ticking=false;
            var y=snap.scrollTop;
            var h=snap.offsetHeight;
            var t=Math.min(1,Math.max(0,y/h));
            // Page 1: fade + shrink to nothing
            noiseLand.style.opacity=(1-t)*0.32;
            noiseLand.style.transform='scale('+(1-t)+')';
            // Page 2: fade + grow from nothing
            if(noiseArch){
              noiseArch.style.opacity=t*0.32;
              noiseArch.style.transform='scale('+t+')';
            }
            if(scrollCue){
              scrollCue.style.opacity=t<0.1?(1-t/0.1):0;
            }
          }
          snap.addEventListener('scroll',onScroll,{passive:true});
          updateGlow();

          if(scrollCue){
            // The intro reveal finishes ~1.3s in, which can be after the reader
            // has already scrolled to page two. Drop the animation and hand
            // opacity straight back to the scroll position, otherwise the cue
            // flashes back on and sits over the product cards.
            scrollCue.addEventListener('animationend',function(){
              scrollCue.style.animation='none';
              updateGlow();
            },{once:true});
          }

          // Snap enforcement — debounced scroll-end detection.
          // A page taller than the viewport owns an interior scroll range; while the
          // viewport rests anywhere inside that range the reader is legitimately parked
          // and must not be pulled back to the page top. Only pages that fit the
          // viewport get re-snapped, so short pages keep the crisp snap and tall ones
          // stay readable on small screens.
          var snapPages=snap.querySelectorAll('.vapor-snap-page');
          var snapTimer=null;
          function enforceSnap(){
            clearTimeout(snapTimer);
            snapTimer=setTimeout(function(){
              var scrollTop=snap.scrollTop;
              var viewportH=snap.clientHeight;
              var maxScroll=snap.scrollHeight-viewportH;
              var closest=null;
              var minDist=Infinity;
              var resting=false;
              for(var i=0;i<snapPages.length;i++){
                var page=snapPages[i];
                var top=page.offsetTop;
                var restEnd=top+page.offsetHeight-viewportH;
                if(scrollTop>top+2&&scrollTop<=restEnd+2){resting=true;break;}
                var dist=Math.abs(top-scrollTop);
                if(dist<minDist){minDist=dist;closest=page;}
              }
              if(resting)return;
              if(scrollTop>=maxScroll-2)return;
              if(closest&&minDist>2){
                closest.scrollIntoView({behavior:'smooth'});
              }
            },120);
          }
          snap.addEventListener('scroll',enforceSnap,{passive:true});

          // Focus reveal. Tabbing into the other page leaves the browser's own
          // focus scroll part-way between pages, and enforceSnap then settles on
          // whichever page top is nearest, which can be the one without the
          // focused control on it. Bring the focused element's page into view,
          // then the element itself if the page is taller than the viewport.
          // Runs a frame late so it lands after the browser's focus scroll, and
          // sets scrollTop with scroll-behavior on auto for the same reason the
          // Products button does (index.astro): mandatory snapping cancels a
          // smooth programmatic scroll.
          function revealFocus(el){
            var page=el.closest('.vapor-snap-page');
            if(!page)return;
            var box=snap.getBoundingClientRect();
            var pageBox=page.getBoundingClientRect();
            var toPageTop=pageBox.top-box.top;
            var delta=0;
            // Not resting inside this page: start from its top.
            if(pageBox.top>box.top+2||pageBox.bottom<box.bottom-2)delta=toPageTop;
            var elBox=el.getBoundingClientRect();
            if(elBox.bottom-delta>box.bottom)delta+=elBox.bottom-delta-box.bottom+16;
            else if(elBox.top-delta<box.top)delta+=elBox.top-delta-box.top-16;
            // Never past this page's top into the page above it.
            delta=Math.max(delta,toPageTop);
            if(Math.abs(delta)<1)return;
            snap.style.scrollBehavior='auto';
            snap.scrollTop+=delta;
            snap.style.removeProperty('scroll-behavior');
          }
          snap.addEventListener('focusin',function(e){
            var el=e.target;
            requestAnimationFrame(function(){
              if(document.activeElement===el)revealFocus(el);
            });
          });
        }
      })();
    </script>
  </body>
</html>