---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';

/**
 * Product catalogue.
 *
 * The page renders entirely from this structure, so adding a listing is a data
 * edit rather than a markup edit. Categories render as the upper toggle, the
 * products inside a category render as that category's tab rail, and each
 * product renders one panel.
 *
 * A product is either a stack (`surfaces` built on top of a `base`, with
 * connectors drawn between the tiers) or a single card (`base` only).
 *
 * Both rails stay usable as listings grow: they wrap on wide viewports and
 * become horizontally scrollable rails on narrow ones.
 */
const catalog = [
  {
    id: 'developer',
    label: 'Developer',
    products: [
      {
        id: 'akira',
        label: 'Akira',
        base: {
          name: 'Akira',
          description:
            'A cross-platform system introspection library providing unified hardware and OS telemetry across Windows, Linux, and macOS.',
          icon: 'akira',
          href: '/akira/',
          label: 'FABRIC',
          variant: 'foundation'
        },
        surfaces: [
          {
            name: 'Akira MCP Server',
            description: 'An MCP server built on Akira, exposing Akira tooling through MCP.',
            icon: 'akira',
            label: 'SURFACE',
            variant: 'surface'
          },
          {
            name: '[Future]',
            description: 'Another system in the pipeline — same foundation, new surface.',
            label: 'SURFACE',
            variant: 'future'
          }
        ]
      },
      {
        id: 'kata',
        label: 'Kata',
        base: {
          name: 'Kata',
          description:
            'A local-first structured text parser and visualizer. Parse, inspect, compare, and export structured text entirely in-browser.',
          icon: 'kata',
          href: '/kata/',
          label: 'SURFACE',
          variant: 'standalone'
        },
        surfaces: []
      }
    ]
  },
  {
    id: 'designer',
    label: 'Designer',
    products: [
      {
        id: 'nfty',
        label: 'NFTY',
        base: {
          name: 'NFTY',
          description:
            'A deterministic generator and pixel editor for layered asset collections. Grayscale value-maps colorized at generation time, with OpenSea metadata built in.',
          icon: 'nfty',
          href: '/nfty/',
          label: 'DESIGN',
          variant: 'standalone'
        },
        surfaces: []
      },
      {
        id: 'crispr',
        label: 'CRISPR',
        base: {
          name: 'CRISPR',
          description:
            'Lossless SVG to PNG, rasterized by a real browser engine. Detects and repairs font substitution.',
          icon: 'crispr',
          href: '/crispr/',
          label: 'DESIGN',
          variant: 'standalone'
        },
        surfaces: []
      }
    ]
  },
  {
    id: 'vaporsoft',
    label: 'Vaporsoft',
    products: [
      {
        id: 'assets',
        label: 'Assets',
        repo: false,
        base: {
          name: 'Assets',
          description:
            'Every mark the site serves, at every size it is drawn at. Wallpapers in three shapes, headers, a social card, an email banner and a badge — vector sources, with rasters rendered from them.',
          iconSrc: '/brand/vaporsoft/vaporsoft-logo.svg',
          iconSrcLight: '/brand/vaporsoft/vaporsoft-logo-light.svg',
          href: '/vaporsoft/',
          label: 'FABRIC',
          variant: 'foundation'
        },
        surfaces: [
          {
            name: 'Icons',
            description: 'Each product mark and favicon, as a vector and a raster, in both themes.',
            iconSrc: '/brand/vaporsoft/vaporsoft-mark-icons.svg',
            iconSrcLight: '/brand/vaporsoft/vaporsoft-mark-icons-light.svg',
            href: '/vaporsoft/icons/',
            label: 'SURFACE',
            variant: 'surface'
          },
          {
            name: 'Palette',
            description: 'Carmine, ink, paper, graphite, and the ramp built on carmine. The values the build enforces.',
            iconSrc: '/brand/vaporsoft/vaporsoft-mark-palette.svg',
            iconSrcLight: '/brand/vaporsoft/vaporsoft-mark-palette-light.svg',
            href: '/vaporsoft/palette/',
            label: 'SURFACE',
            variant: 'surface'
          }
        ]
      },
      {
        id: 'donate',
        label: 'Donate',
        repo: false,
        base: {
          name: 'Donate',
          description:
            'A way to support the work directly, for anyone who finds it useful. Not open yet.',
          iconSrc: '/brand/vaporsoft/vaporsoft-mark-donate.svg',
          iconSrcLight: '/brand/vaporsoft/vaporsoft-mark-donate-light.svg',
          label: 'SURFACE',
          variant: 'future'
        },
        surfaces: []
      },
      {
        id: 'merch',
        label: 'Merch',
        repo: false,
        base: {
          name: 'Merch',
          description:
            'Nothing to print yet. When there is, it comes off these same files — which is why they are drawn as vectors at every size first.',
          iconSrc: '/brand/vaporsoft/vaporsoft-mark-merch.svg',
          iconSrcLight: '/brand/vaporsoft/vaporsoft-mark-merch-light.svg',
          label: 'SURFACE',
          variant: 'future'
        },
        surfaces: []
      }
    ]
  }
];

const defaultCategoryId = catalog[0].id;
const flatProducts = catalog.flatMap((category) =>
  category.products.map((product) => ({ ...product, categoryId: category.id }))
);
const defaultProductByCategory = Object.fromEntries(
  catalog.map((category) => [category.id, category.products[0] ? category.products[0].id : ''])
);

const siteUrl = Astro.site ?? new URL('https://www.vaporsoft.dev');
const homePageStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Vaporsoft',
    url: new URL('/', siteUrl).href,
    description: 'Vaporsoft builds software contracting systems, MCP servers, and browser-first digital tools.',
    isPartOf: {
      '@type': 'WebSite',
      name: 'Vaporsoft',
      url: siteUrl.href
    },
    mainEntity: {
      '@type': 'ItemList',
      name: 'Vaporsoft products',
      itemListElement: flatProducts.map((product, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: product.base.name,
        ...(product.base.href ? { url: new URL(product.base.href, siteUrl).href } : {})
      }))
    }
  },
  ...flatProducts
    .filter((product) => product.repo !== false && Boolean(product.base.href))
    .map((product) => ({
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: product.base.name,
      url: new URL(product.base.href, siteUrl).href,
      codeRepository: `https://github.com/corderro-artz/${product.id}`,
      author: {
        '@type': 'Organization',
        name: 'Vaporsoft'
      },
      description: product.base.description
    }))
];
---

<BaseLayout
  title="Vaporsoft | Native, Web, AI, and Digital Assets"
  description="Vaporsoft builds open-source developer and design tools: Akira system telemetry, Kata text parsing, NFTY asset generation, CRISPR SVG rasterizing."
  themeColor="#f2ede6"
  bodyClass="vapor-body"
  keywords={[
    'software contracting',
    'MCP server',
    'digital tools',
    'Akira',
    'Kata',
    'NFTY',
    'CRISPR',
    'cross-platform telemetry',
    'local-first tools'
  ]}
  structuredData={homePageStructuredData}
>
  <div class="vapor-snap-container">

    <!-- ── Page 1 · Landing ── -->
    <section class="vapor-snap-page">
      <main class="vapor-site vapor-landing">
        <div class="vapor-noise vapor-noise--landing"></div>

        <div class="vapor-landing-center">
          <span class="vapor-brand-mark vapor-landing-mark"></span>

          <h1 class="vapor-heading">VAPORSOFT</h1>

          <div class="vapor-rule">
            <span></span>
            <strong>仮想</strong>
            <span></span>
          </div>

          <p class="vapor-landing-tagline">
            <span class="vapor-tagline-segment vapor-tagline-segment--muted">Native</span>
            <span class="vapor-tagline-sep" aria-hidden="true"></span>
            <span class="vapor-tagline-segment vapor-tagline-segment--muted">Web</span>
            <span class="vapor-tagline-sep" aria-hidden="true"></span>
            <span class="vapor-tagline-segment vapor-tagline-segment--accent">AI</span>
            <span class="vapor-tagline-sep" aria-hidden="true"></span>
            <span class="vapor-tagline-segment vapor-tagline-segment--accent">Assets</span>
          </p>

          <nav class="vapor-landing-nav" aria-label="Primary">
            <div class="vapor-landing-nav-row">
              <button type="button" class="vapor-inline-link" data-scroll-target="products" aria-controls="products">Products</button>
              <a class="vapor-inline-link" href="/contact/">Contact</a>
            </div>
            <button type="button" class="vapor-theme-toggle" data-theme-toggle aria-label="Toggle theme">
              <span class="vapor-theme-toggle-dot"></span>
              <span data-theme-label>LIGHT</span>
            </button>
          </nav>
        </div>

        <div class="vapor-scroll-cue" aria-hidden="true">
          <span class="vapor-scroll-cue-label">Scroll</span>
          <span class="vapor-scroll-cue-line"></span>
        </div>
      </main>
    </section>

    <!-- ── Page 2 · Products ── -->
    <section class="vapor-snap-page" id="products">
      <div class="vapor-site vapor-arch">
        <div class="vapor-noise vapor-noise--arch"></div>

        <header class="vapor-arch-header">
          <p class="vapor-kicker">Fabric &amp; Surface</p>
          <h2 class="vapor-title">A single loom</h2>
          <div class="vapor-rule vapor-rule--compact">
            <span></span>
            <strong>織</strong>
            <span></span>
          </div>
          <h2 class="vapor-title">to spin many threads</h2>
        </header>

        <!-- Tier 1 · category toggle -->
        <div class="vapor-category-nav" role="tablist" aria-label="Product categories">
          {catalog.map((category) => (
            <button
              type="button"
              class="vapor-category-tab"
              role="tab"
              id={`category-tab-${category.id}`}
              data-category={category.id}
              aria-selected={category.id === defaultCategoryId ? 'true' : 'false'}
              aria-controls={`product-rail-${category.id}`}
              tabindex={category.id === defaultCategoryId ? 0 : -1}
            >{category.label}</button>
          ))}
        </div>

        <!-- Tier 2 · product rail, one per category -->
        <div class="vapor-product-rails">
          {catalog.map((category) => (
            <div
              class="vapor-product-rail"
              role="tablist"
              id={`product-rail-${category.id}`}
              aria-labelledby={`category-tab-${category.id}`}
              data-product-rail={category.id}
              hidden={category.id !== defaultCategoryId}
            >
              {category.products.map((product, index) => (
                <button
                  type="button"
                  class="vapor-product-tab"
                  role="tab"
                  id={`product-tab-${product.id}`}
                  data-product={product.id}
                  data-category-of={category.id}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={`product-panel-${product.id}`}
                  tabindex={index === 0 ? 0 : -1}
                >{product.label}</button>
              ))}
            </div>
          ))}
        </div>

        <div class="vapor-product-panels">
          {flatProducts.map((product) => {
            const isDefault =
              product.categoryId === defaultCategoryId &&
              defaultProductByCategory[product.categoryId] === product.id;
            return (
              <div
                class:list={['vapor-product-panel', isDefault && 'vapor-product-panel--active']}
                role="tabpanel"
                id={`product-panel-${product.id}`}
                aria-labelledby={`product-tab-${product.id}`}
                data-product-panel={product.id}
                data-category-of={product.categoryId}
                aria-hidden={isDefault ? 'false' : 'true'}
                hidden={!isDefault}
              >
                <div class="vapor-arch-stack">
                  {product.surfaces.length > 0 && (
                    <>
                      <div class="vapor-arch-tier vapor-arch-tier--upper">
                        {product.surfaces.map((surface) => (
                          <ProductCard {...surface} />
                        ))}
                      </div>

                      <div class="vapor-arch-connectors" aria-hidden="true">
                        <div class="vapor-arch-connector vapor-arch-connector--left"></div>
                        <div class="vapor-arch-connector vapor-arch-connector--right"></div>
                        <div class="vapor-arch-connector-trunk"></div>
                      </div>
                    </>
                  )}

                  <div class="vapor-arch-tier vapor-arch-tier--base">
                    <ProductCard {...product.base} />
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <footer class="vapor-landing-footer">
          <p>&copy; 2026 Corderro Artz / Vaporsoft. All rights reserved.</p>
        </footer>
      </div>
    </section>

  </div>

  <script is:inline define:vars={{ defaultProductByCategory }}>
    (function(){
      var scrollTargets = document.querySelectorAll('[data-scroll-target]');
      scrollTargets.forEach(function(trigger) {
        trigger.addEventListener('click', function() {
          var targetId = trigger.getAttribute('data-scroll-target');
          var target = targetId ? document.getElementById(targetId) : null;
          if (!target) return;
          // This button did nothing at all. scrollIntoView() and scrollTo() are
          // both cancelled by the container's mandatory snapping, and so is a
          // scrollTop assignment while the container's CSS scroll-behavior is
          // smooth — the scroll never starts. Assigning scrollTop with
          // scroll-behavior temporarily set to auto is honoured. The override is
          // put back on the next frame so wheel and touch scrolling keep the
          // behaviour they had. Offsets come from rects because offsetTop is
          // relative to the offset parent, which here is the body, not the
          // scroller.
          var container = target.closest('.vapor-snap-container');
          if (!container) {
            target.scrollIntoView({ behavior: 'smooth' });
            return;
          }
          var previousBehavior = container.style.scrollBehavior;
          container.style.scrollBehavior = 'auto';
          container.scrollTop += target.getBoundingClientRect().top - container.getBoundingClientRect().top;
          // scroll-behavior only applies at the moment of the assignment, and
          // the assignment above is synchronous, so the override can be undone
          // immediately rather than on a later frame.
          if (previousBehavior) {
            container.style.scrollBehavior = previousBehavior;
          } else {
            container.style.removeProperty('scroll-behavior');
          }
        });
      });

      var categoryTabs = Array.prototype.slice.call(document.querySelectorAll('[data-category]'));
      var rails = Array.prototype.slice.call(document.querySelectorAll('[data-product-rail]'));
      var productTabs = Array.prototype.slice.call(document.querySelectorAll('[data-product]'));
      var panels = Array.prototype.slice.call(document.querySelectorAll('[data-product-panel]'));
      if (!categoryTabs.length || !panels.length) return;

      // The last product the visitor opened in each category, so switching back
      // and forth between categories does not throw away their place.
      var lastProduct = {};
      Object.keys(defaultProductByCategory).forEach(function(key) {
        lastProduct[key] = defaultProductByCategory[key];
      });

      function setTabState(tab, selected) {
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.setAttribute('tabindex', selected ? '0' : '-1');
      }

      // Each rail is its own tablist, so selection is updated only within the
      // rail that owns the product — every rail keeps exactly one selected tab,
      // including the ones currently hidden behind another category.
      function showProduct(categoryId, productId) {
        productTabs.forEach(function(tab) {
          if (tab.getAttribute('data-category-of') !== categoryId) return;
          setTabState(tab, tab.getAttribute('data-product') === productId);
        });
        panels.forEach(function(panel) {
          var active = panel.getAttribute('data-product-panel') === productId;
          panel.classList.toggle('vapor-product-panel--active', active);
          panel.hidden = !active;
          panel.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
      }

      function showCategory(categoryId) {
        categoryTabs.forEach(function(tab) {
          setTabState(tab, tab.getAttribute('data-category') === categoryId);
        });
        rails.forEach(function(rail) {
          rail.hidden = rail.getAttribute('data-product-rail') !== categoryId;
        });
        showProduct(categoryId, lastProduct[categoryId]);
      }

      // Roving-tabindex arrow navigation, per WAI-ARIA tabs pattern.
      function wireArrowKeys(tabs, activate) {
        tabs.forEach(function(tab) {
          tab.addEventListener('keydown', function(event) {
            var visible = tabs.filter(function(candidate) {
              return candidate.offsetParent !== null;
            });
            var index = visible.indexOf(tab);
            if (index === -1) return;
            var next = null;
            if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = visible[(index + 1) % visible.length];
            else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = visible[(index - 1 + visible.length) % visible.length];
            else if (event.key === 'Home') next = visible[0];
            else if (event.key === 'End') next = visible[visible.length - 1];
            if (!next) return;
            event.preventDefault();
            activate(next);
            next.focus();
          });
        });
      }

      categoryTabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          showCategory(tab.getAttribute('data-category'));
        });
      });
      wireArrowKeys(categoryTabs, function(tab) {
        showCategory(tab.getAttribute('data-category'));
      });

      function selectProductTab(tab) {
        var categoryId = tab.getAttribute('data-category-of');
        lastProduct[categoryId] = tab.getAttribute('data-product');
        showProduct(categoryId, lastProduct[categoryId]);
      }

      productTabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          selectProductTab(tab);
        });
      });
      wireArrowKeys(productTabs, selectProductTab);
    })();
  </script>
</BaseLayout>
